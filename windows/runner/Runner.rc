#pragma code_page(65001)
#include <windows.h>
101 ICON "resources\\app_icon.ico"
#ifndef FLUTTER_VERSION_MAJOR
#define FLUTTER_VERSION_MAJOR 1
#define FLUTTER_VERSION_MINOR 0
#define FLUTTER_VERSION_PATCH 0
#define FLUTTER_VERSION_BUILD 1
#endif
#ifndef FLUTTER_VERSION
#define FLUTTER_VERSION "1.0.0"
#endif
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
 PRODUCTVERSION FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904e4"
  BEGIN
   VALUE "CompanyName", "Chess 2.0" "\0"
   VALUE "FileDescription", "Шахматы 2.0" "\0"
   VALUE "FileVersion", FLUTTER_VERSION "\0"
   VALUE "InternalName", "chess_2" "\0"
   VALUE "LegalCopyright", "Copyright (C) 2026" "\0"
   VALUE "OriginalFilename", "chess_2.exe" "\0"
   VALUE "ProductName", "Шахматы 2.0" "\0"
   VALUE "ProductVersion", FLUTTER_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1252
 END
END
